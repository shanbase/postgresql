NODE_ENV=production
PGDATA=./data/postgres
PGPORT=5432
PG_LISTEN_ADDRESSES=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=off
POSTGRES_SSL_CERT=
POSTGRES_SSL_KEY=
PG_MAX_CONNECTIONS=30
PG_SHARED_BUFFERS=768MB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_WAL_SIZE=512MB
HEALTH_PORT=8080
