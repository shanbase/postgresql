# ─────────────────────────────────────────────────────────────────────────────
# Veyra PostgreSQL — environment configuration
# Copy to `.env` (or set these as real environment variables on your host).
# Every value below is optional unless marked REQUIRED-ish; sane defaults exist.
# ─────────────────────────────────────────────────────────────────────────────

# Port PostgreSQL listens on. (default: 25204)
PG_PORT=25204

# Database superuser name created by initdb. (default: postgres)
PG_SUPERUSER=postgres

# Superuser password. If left EMPTY a strong random password is generated on
# first boot, printed once to the terminal, and saved to .pg-credentials (0600).
PG_PASSWORD=

# Comma-separated list of databases to create on first boot.
# (default: postgres — the maintenance db initdb already creates)
PG_DATABASE=postgres

# ── Networking ────────────────────────────────────────────────────────────────
# Addresses PostgreSQL binds to. '*' = all interfaces (needed if your hosting
# platform proxies TCP traffic to this port). Use '127.0.0.1' for localhost only.
PG_LISTEN=*

# Comma-separated CIDRs allowed to connect over the network.
# Anything not listed is rejected by pg_hba.conf. (default: all IPv4 + IPv6)
PG_ALLOWED_CIDRS=0.0.0.0/0,::/0

# Unix socket directory used for local connections. (default: /tmp)
PG_SOCKET_DIR=/tmp

# ── TLS / SSL ────────────────────────────────────────────────────────────────
# 'on'  → TLS enabled. Uses PG_SSL_CERT_FILE/PG_SSL_KEY_FILE if both are set,
#         otherwise generates a self-signed pair automatically.
# 'off' → no certs are generated and ssl=off in postgresql.conf.
PG_SSL=off

# Optional: paths to YOUR OWN certificate + private key (PEM). Both must be
# set together. Leave empty to auto-generate a self-signed certificate.
# Paths are relative to this folder (or absolute).
PG_SSL_CERT_FILE=
PG_SSL_KEY_FILE=

# CN/SAN placed in the auto-generated certificate. Defaults to hostname.
# (ignored when PG_SSL_CERT_FILE/PG_SSL_KEY_FILE are set)
PG_SSL_CN=

# Certificate validity in days for the auto-generated cert. (default: 825)
PG_SSL_DAYS=825

# Minimum TLS protocol version. (default: TLSv1.2)
PG_SSL_MIN_VERSION=TLSv1.2

# ── Memory / performance ─────────────────────────────────────────────────────
# Postgres memory settings. Accepts plain numbers (kB) or suffixed values
# like 128MB / 1GB. Tune to your host's RAM.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB

# ── Connections / WAL ────────────────────────────────────────────────────────
PG_MAX_CONNECTIONS=50
PG_MAX_WAL_SIZE=1GB

# ── Storage ──────────────────────────────────────────────────────────────────
# Data directory. (default: ./data next to index.mjs)
PG_DATA=./data

# Optional: directory containing postgres binaries (initdb, postgres, psql...).
# If unset, binaries are found on PATH or in common install locations.
PG_BIN=

# Optional: pin a major version when installing (e.g. 16). Empty = latest.
PG_VERSION=

# 'auto' → install PostgreSQL via the system package manager if binaries are
# missing. 'never' → fail if binaries are not already present.
PG_INSTALL=auto

# OS user that the postgres server process runs as when this app runs as root.
# (default: 'postgres' — created automatically if missing)
PG_OS_USER=postgres

# ── Health endpoint ──────────────────────────────────────────────────────────
# Optional tiny HTTP status server. 0/empty = disabled.
# GET /healthz → {"status":"ok",...}   GET / → server info
HEALTH_PORT=

# sslmode used by internal admin connections (createdb etc.).
# 'prefer' = use TLS when the server offers it, plaintext otherwise.
# Only relevant when PG_SSL=on. Use 'verify-full' with a real CA cert.
PG_SSLMODE=prefer

# ── Replica mode (optional) ──────────────────────────────────────────────
# Set PG_REPLICA_HOST to run this node as a read-only streaming replica of a
# remote primary instead of bootstrapping a fresh database. The data dir is
# seeded with pg_basebackup and database/role creation is skipped.
# PG_REPLICA_HOST=mn-uln01.altare.global
# PG_REPLICA_PORT=25204
# PG_REPLICA_USER=veyra_replicator
# PG_REPLICA_PASSWORD=
# PG_REPLICA_SLOT=veyra_eu_slot
# PG_REPLICA_DB=postgres
